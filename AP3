import java.util.*;

abstract class Seat {
    String id;

    Seat(String id) {
        this.id = id;
    }

    abstract double getPrice();
}

class RegularSeat extends Seat {
    RegularSeat(String id) {
        super(id);
    }

    double getPrice() {
        return 150;
    }
}

class PremiumSeat extends Seat {
    PremiumSeat(String id) {
        super(id);
    }

    double getPrice() {
        return 250;
    }
}

class ReclinerSeat extends Seat {
    ReclinerSeat(String id) {
        super(id);
    }

    double getPrice() {
        return 400;
    }
}

class Customer {
    String name;

    Customer(String name) {
        this.name = name;
    }
}

class Show {
    String time;
    boolean started = false;
    Set<String> booked = new HashSet<>();

    Show(String time) {
        this.time = time;
    }

    boolean bookSeats(List<Seat> seats) {
        if (seats.isEmpty() || seats.size() > 6) {
            System.out.println("Booking must contain 1 to 6 seats.");
            return false;
        }

        Set<String> requested = new HashSet<>();

        for (Seat seat : seats) {
            if (booked.contains(seat.id) || !requested.add(seat.id)) {
                System.out.println("Seat " + seat.id
                        + " is already booked for this show.");
                return false;
            }
        }

        booked.addAll(requested);
        return true;
    }

    void releaseSeats(List<Seat> seats) {
        for (Seat seat : seats) {
            booked.remove(seat.id);
        }
    }
}

class Booking {
    Customer customer;
    Show show;
    List<Seat> seats;
    boolean cancelled = false;

    Booking(Customer customer, Show show, List<Seat> seats) {
        this.customer = customer;
        this.show = show;
        this.seats = new ArrayList<>(seats);
    }

    void confirm() {
        if (show.bookSeats(seats)) {
            System.out.print("Booking confirmed for " + customer.name + ": ");
            for (int i = 0; i < seats.size(); i++) {
                System.out.print(seats.get(i).id);
                if (i < seats.size() - 1) System.out.print(", ");
            }

            System.out.printf(". Total: ₹%.2f.%n",
                    seats.stream().mapToDouble(Seat::getPrice).sum());
        }
    }

    void cancel() {
        if (cancelled) {
            System.out.println("Booking already cancelled.");
            return;
        }

        if (show.started) {
            System.out.println("Cannot cancel after the show starts.");
            return;
        }

        show.releaseSeats(seats);
        cancelled = true;
        System.out.println(customer.name + "'s booking cancelled.");

        System.out.print("Seats ");
        for (int i = 0; i < seats.size(); i++) {
            System.out.print(seats.get(i).id);
            if (i < seats.size() - 1) System.out.print(", ");
        }
        System.out.println(" released.");
    }
}

public class CampusPremiereTicketCounter {
    public static void main(String[] args) {
        Show show = new Show("7 PM");
        Customer asha = new Customer("Asha");
        Customer ravi = new Customer("Ravi");
        Customer neha = new Customer("Neha");

        Booking b1 = new Booking(asha, show, Arrays.asList(
                new RegularSeat("A1"),
                new RegularSeat("A2"),
                new PremiumSeat("F5")));
        b1.confirm();

        Booking b2 = new Booking(ravi, show,
                Arrays.asList(new RegularSeat("A2")));
        b2.confirm();

        Booking b3 = new Booking(ravi, show,
                Arrays.asList(new ReclinerSeat("R1")));
        b3.confirm();

        b1.cancel();

        Booking b4 = new Booking(neha, show,
                Arrays.asList(new RegularSeat("A2")));
        b4.confirm();
    }
}
