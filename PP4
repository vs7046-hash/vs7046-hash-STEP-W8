import java.time.LocalDate;
import java.util.*;

abstract class Room {
    int number;
    double rate;

    Room(int number, double rate) {
        this.number = number;
        this.rate = rate;
    }

    abstract double calculatePrice(long days);
}

class StandardRoom extends Room {
    StandardRoom(int number) {
        super(number, 100);
    }

    double calculatePrice(long days) {
        return days * rate;
    }
}

class DeluxeRoom extends Room {
    DeluxeRoom(int number) {
        super(number, 200);
    }

    double calculatePrice(long days) {
        return days * rate;
    }
}

class Suite extends Room {
    Suite(int number) {
        super(number, 300);
    }

    double calculatePrice(long days) {
        return days * rate;
    }
}

class Customer {
    String name;

    Customer(String name) {
        this.name = name;
    }
}

class Reservation {
    Customer customer;
    Room room;
    LocalDate start;
    LocalDate end;
    boolean active = true;

    Reservation(Customer customer, Room room, LocalDate start, LocalDate end) {
        this.customer = customer;
        this.room = room;
        this.start = start;
        this.end = end;
    }

    boolean overlaps(LocalDate s, LocalDate e) {
        return active && start.isBefore(e) && s.isBefore(end);
    }

    void cancel() {
        if (active && LocalDate.now().isBefore(start)) {
            active = false;
            System.out.println("Reservation cancelled successfully.");
        } else {
            System.out.println("Cancellation deadline passed.");
        }
    }
}

public class Main {
    static List<Reservation> reservations = new ArrayList<>();

    static boolean available(Room room, LocalDate start, LocalDate end) {
        for (Reservation r : reservations) {
            if (r.room.number == room.number && r.overlaps(start, end))
                return false;
        }
        return true;
    }

    static void book(Customer customer, Room room, LocalDate start,
                     LocalDate end) {
        if (!start.isBefore(end)) {
            System.out.println("Invalid reservation dates.");
            return;
        }

        if (!available(room, start, end)) {
            System.out.println("Room " + room.number + " is not available.");
            return;
        }

        Reservation r = new Reservation(customer, room, start, end);
        reservations.add(r);

        System.out.println("Reservation confirmed for " + customer.name +
                ", Room " + room.number);
        System.out.println("Price: $" +
                room.calculatePrice(java.time.temporal.ChronoUnit.DAYS.between(start, end)));
    }

    public static void main(String[] args) {
        Customer a = new Customer("Customer A");
        Customer b = new Customer("Customer B");
        Customer c = new Customer("Customer C");

        Room standard = new StandardRoom(101);
        Room deluxe = new DeluxeRoom(201);

        LocalDate s1 = LocalDate.of(2027, 1, 1);
        LocalDate e1 = LocalDate.of(2027, 1, 5);

        book(a, standard, s1, e1);
        book(b, standard, LocalDate.of(2027, 1, 3),
                LocalDate.of(2027, 1, 7));

        reservations.get(0).cancel();

        book(c, deluxe, LocalDate.of(2027, 2, 10),
                LocalDate.of(2027, 2, 12));
    }
}
